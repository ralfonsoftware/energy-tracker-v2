<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below override the version of a package that only arrives transitively.
         Used for the two audit pins at the end of this file. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core — pinned to one version across every project to avoid transitive version conflicts -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- Auth — Data Protection key persistence, same 10.0.10 line as the rest of EF Core (AD-17) -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
    <!-- The OIDC handler's Microsoft.IdentityModel.* dependencies are heavy enough that this
         handler ships as a separate NuGet package rather than in the shared framework, unlike
         the cookie handler (which does ship in Microsoft.AspNetCore.App) — verified against
         NuGet at implementation time, not assumed. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />

    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <!-- Dependency-free logging abstraction — lets EnergyTracker.Application log a
         swallow-and-continue failure (CompleteSmartPlugImportProcessing) without pulling in
         ASP.NET Core or any concrete logging provider. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />

    <!-- OTel (AD-19 extension) -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <!-- Still beta-only upstream (OTel .NET Contrib has never shipped a stable release of this
         package — rechecked 2026-10-11: 1.19.1-beta.1 is the newest); accepted anyway since it's the
         only EF Core tracing option available, and only affects instrumentation, not reliability. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.19.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />

    <!-- AD-6 async job queue cloud adapter (AzureStorageQueueJobQueue) -->
    <PackageVersion Include="Azure.Storage.Queues" Version="12.28.1" />

    <!-- AD-9 Eve Home .xlsx parser (EveHomeXlsxParser). The real sample files store their date
         column as OOXML's ISO-8601 "t=d" cell type (dimension A1:B57184) rather than the usual
         numeric date serial — ClosedXML 0.105.1 throws FormatException loading that cell type
         (verified directly against sample-data/eve/*.xlsx), so this reads the OOXML package
         directly via the lower-level SDK ClosedXML itself wraps instead. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />

    <!-- AD-23 bulk-write adoption (SmartPlugImportRepository.AddAsync's primary, known-PowerPoint
         match-key path). Explicit .Core+.SqlServer+.PostgreSql references only — never the
         umbrella EFCore.BulkExtensions package, which unconditionally pulls in the Oracle and
         SQLite adapters this project doesn't need. -->
    <PackageVersion Include="EFCore.BulkExtensions.Core" Version="10.0.1" />
    <PackageVersion Include="EFCore.BulkExtensions.SqlServer" Version="10.0.1" />
    <PackageVersion Include="EFCore.BulkExtensions.PostgreSql" Version="10.0.1" />

    <!-- Testing -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- 4.14.0+ bumps its own SSH.NET dependency to 2026.0.0, past 2025.1.0's two high-severity
         ScpClient advisories (GHSA-q939-rpr3-3284 path traversal, GHSA-mggc-4xg6-vcxf command
         injection) — no local override needed. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />

    <!-- NuGet Audit gate (Directory.Build.props): these two arrive only transitively and the versions
         they came with are flagged (System.Security.Cryptography.Pkcs 9.0.11 via Microsoft.Data.SqlClient
         6.1.6, Pkcs/Xml 10.0.12 via the ASP.NET Core packages): GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx,
         GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83. 10.0.13 is the patched release.
         Transitive pinning (above) applies it everywhere. Remove these pins once the packages that
         bring them in ask for a patched version themselves. Never suppress the advisories. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

</Project>
