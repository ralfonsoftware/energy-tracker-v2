<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EnergyTracker.Domain\EnergyTracker.Domain.csproj" />
    <ProjectReference Include="..\EnergyTracker.Application\EnergyTracker.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Story 3.6/AD-6 extension: BackgroundJobProcessor.ProcessAsync and JobMessage are internal
         (job-processing plumbing, not a public port) — Infrastructure.Tests needs direct access
         to exercise the enqueue-time Queued row -> dequeue-time transition, same precedent as
         EnergyTracker.Api's own InternalsVisibleTo for OIDC claim-validation logic. -->
    <InternalsVisibleTo Include="EnergyTracker.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- IHttpContextAccessor (used by CurrentHouseholdAccessor) and the cookie/OIDC auth types
         ship in the ASP.NET Core shared framework, not a NuGet package — Infrastructure isn't
         Sdk.Web like Api, so it needs this FrameworkReference explicitly to see them. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Azure.Storage.Queues" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <!-- AD-23 bulk-write adoption (SmartPlugImportRepository.AddAsync's primary match-key path). -->
    <PackageReference Include="EFCore.BulkExtensions.Core" />
    <PackageReference Include="EFCore.BulkExtensions.SqlServer" />
    <PackageReference Include="EFCore.BulkExtensions.PostgreSql" />
    <!-- AD-2 [AMENDED 2026-09-04, Story 3.9]: SmartPlugImportRepository's AwaitingPowerPointMapping
         raw-SQL upsert needs Database.IsNpgsql()/IsSqlServer() to pick which provider-native
         statement to run — the one narrow, named exception to "provider chosen once, at the
         composition root". -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
