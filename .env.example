# Copy this file to .env and fill in real values. .env is git-ignored — never commit real secrets.

# Postgres (default provider, docker-compose.yml)
POSTGRES_USER=energytracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=energytracker

# SQL Server (optional provider, docker-compose.sqlserver.yml)
MSSQL_SA_PASSWORD=change-me-too-Str0ng!
MSSQL_DB=energytracker

# Story 1.5 (household provisioning via OIDC) — a real OIDC provider app registration (Entra ID,
# Auth0, Authentik, Keycloak, or equivalent) is required to run this instance. OIDC_AUTHORITY and
# OIDC_CLIENT_ID are not secret; OIDC_CLIENT_SECRET is.
#
# For local dev, register a separate app/client from whatever the deployed Container App uses —
# these values are intentionally independent, not shared. See docs/local-development.md's
# "First-time setup" section for why.
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Dedicated test user on the local OIDC app registration above — used only for live/browser
# end-to-end verification (e.g. Claude-in-Chrome walkthroughs); never read by the application
# itself. Log in with OIDC_TEST_USER_NAME (the "Benutzername" field), not the email — this
# Auth0 tenant's connection identifies users by username, not email address. See
# docs/local-development.md's "Live browser verification with the test user" section.
OIDC_TEST_USER_EMAIL=
OIDC_TEST_USER_NAME=
OIDC_TEST_USER_PASSWORD=

# Data Protection keys (the keys that sign your session cookie) are stored in the database. Outside
# Development the app REFUSES TO START unless they are protected, because anyone who can read the
# database or a backup could otherwise forge a login. Pick one (docs/self-hosting.md, "Data
# Protection keys"):
#
# 1. A certificate (recommended): base64-encode a PKCS12 (.pfx) file and set both lines below.
#    macOS: `base64 -i dp.pfx | tr -d '\n'`   Linux: `base64 -w0 dp.pfx`
DATA_PROTECTION_CERTIFICATE_BASE64=
DATA_PROTECTION_CERTIFICATE_PASSWORD=
#
# 2. Deliberately store the keys unprotected. Only for a single-user box whose database and
#    backups nobody else can read. Must be exactly "true"; anything else still refuses to start.
# DATA_PROTECTION_ALLOW_UNPROTECTED_KEYS=true

# Reserved for a later epic (AI-assisted features) — leave blank until then
AI_API_KEY=
