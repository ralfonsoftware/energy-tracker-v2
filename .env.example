# Copy this file to .env and fill in real values. .env is git-ignored — never commit real secrets.

# Postgres (default provider, docker-compose.yml)
POSTGRES_USER=energytracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=energytracker

# SQL Server (optional provider, docker-compose.sqlserver.yml)
MSSQL_SA_PASSWORD=change-me-too-Str0ng!
MSSQL_DB=energytracker

# Story 1.5 (household provisioning via OIDC) — a real OIDC provider app registration (Entra ID,
# Auth0, Authentik, Keycloak, or equivalent) is required to run this instance. OIDC_AUTHORITY and
# OIDC_CLIENT_ID are not secret; OIDC_CLIENT_SECRET is.
#
# For local dev, register a separate app/client from whatever the deployed Container App uses —
# these values are intentionally independent, not shared. See docs/local-development.md's
# "First-time setup" section for why.
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Encrypts Data Protection keys at rest (DataProtectionKeys table) — without this, key XML is
# stored in plaintext (no DPAPI on Linux) and anyone with DB read access could forge a valid
# session cookie. Optional but strongly recommended: base64-encode a PKCS12 (.pfx) certificate,
# e.g. `base64 -i cert.pfx`. Leave blank to keep the previous (documented risk) unencrypted
# behavior until a certificate is provisioned.
DATA_PROTECTION_CERTIFICATE_BASE64=
DATA_PROTECTION_CERTIFICATE_PASSWORD=

# Reserved for a later epic (AI-assisted features) — leave blank until then
AI_API_KEY=
