{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: Launch API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/EnergyTracker.Api/bin/Debug/net10.0/EnergyTracker.Api.dll",
      "cwd": "${workspaceFolder}/src/EnergyTracker.Api",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Frontend: Launch Chrome against Vite dev server",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web",
      "preLaunchTask": "dev-frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full stack: API + Frontend",
      "configurations": [".NET: Launch API", "Frontend: Launch Chrome against Vite dev server"]
    }
  ]
}
